{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "proqpay-ess",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-08-22",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "proqpay-lite-production",
      "database_id": "ac3f8b48-bd87-44bd-9286-f0e0bab6e39f"
    }
  ],
  "ai": { "binding": "AI" },
  "vars": {
    "DEFAULT_ORG_ID": "ORG-OTSINDO",
    "WORKERS_AI_MODEL": "@cf/meta/llama-3.1-8b-instruct-fast",
    "LITE_API_BASE": "https://proqpay-lite.pages.dev",
    "PORTAL_PIN_FALLBACK": "0"
  }
}
